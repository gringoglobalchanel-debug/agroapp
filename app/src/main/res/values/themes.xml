<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Agroapp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryVariant">#1B5E20</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="Theme.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="Theme.Agroapp.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryVariant">#1B5E20</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurface">#1A1A1A</item>
        <item name="android:textColorHint">#888888</item>
        <item name="android:editTextColor">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="editTextStyle">@style/DarkEditText</item>
    </style>

    <!-- ✅ NUEVO: estilo para campos de texto oscuros -->
    <style name="DarkEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#888888</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- ✅ NUEVO: estilo para TextInputLayout oscuro -->
    <style name="DarkTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#1A1A1A</item>
        <item name="boxStrokeColor">#2E7D32</item>
        <item name="hintTextColor">@color/green_700</item>
        <item name="android:textColorHint">#888888</item>
    </style>

</resources>