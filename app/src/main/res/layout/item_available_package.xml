<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cabecera del paquete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvPackageSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paquete #12345678"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1B5E20" />

            <TextView
                android:id="@+id/tvOrdersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5/20"
                android:textSize="12sp"
                android:textColor="#757575"
                android:background="#F5F5F5"
                android:padding="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:cardCornerRadius="12dp" />

        </LinearLayout>

        <!-- LISTA DE PEDIDOS DENTRO DEL PAQUETE -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrdersInPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Resumen del pago -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$11.25"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvCreatedAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Creado: 21/03 10:30"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnTakePackage"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Tomar paquete"
            android:backgroundTint="#2E7D32"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>