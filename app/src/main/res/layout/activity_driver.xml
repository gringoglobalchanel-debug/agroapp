<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2E7D32"
        android:title="Modo Repartidor"
        android:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@android:color/white" />

    <!-- Resumen de ganancias semanales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:padding="16dp"
        android:layout_margin="12dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 Ganancias esta semana"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total entregas:"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvTotalDeliveries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTotalTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💸 Propinas: $0.00"
            android:textSize="14sp"
            android:textColor="#FF9800"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ganancia neta:"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvThisWeekEarnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Próximo pago:"
                android:textSize="12sp"
                android:textColor="#999999" />

            <TextView
                android:id="@+id/tvNextPaymentDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Viernes 27/03"
                android:textSize="12sp"
                android:textColor="#999999" />

        </LinearLayout>

    </LinearLayout>

    <!-- Tabs para cambiar entre envíos disponibles y mis envíos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:weightSum="2">

        <Button
            android:id="@+id/btnAvailableBlocks"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Envíos Disponibles"
            android:textSize="13sp"
            android:backgroundTint="#2E7D32"
            android:layout_marginEnd="4dp"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnMyBlocks"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Mis Envíos"
            android:textSize="13sp"
            android:backgroundTint="#9E9E9E"
            android:layout_marginStart="4dp"
            android:minHeight="48dp"
            android:paddingHorizontal="4dp"
            android:singleLine="true" />

    </LinearLayout>

    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <!-- Lista de envíos disponibles -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAvailableBlocks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Lista de mis envíos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyBlocks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Botón cerrar sesión -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cerrar Sesión"
        android:textSize="14sp"
        android:backgroundTint="#757575"
        android:layout_margin="16dp"
        android:minHeight="48dp" />

</LinearLayout>